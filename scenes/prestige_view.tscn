[gd_scene format=3]

[ext_resource type="Script" path="res://src/ui/prestige_view.gd" id="1_pv"]
[ext_resource type="Script" path="res://src/ui/hold_button.gd" id="2_hold"]

[node name="PrestigeView" type="Control"]
layout_mode = 3
