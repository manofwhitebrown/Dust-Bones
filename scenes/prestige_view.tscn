text = "Move On"

[node name="Site" type="Label" parent="Scroll/Box"]
layout_mode = 2
theme_override_font_sizes/font_size = 52
autowrap_mode = 3

[node name="Gain" type="Label" parent="Scroll/Box"]
layout_mode = 2
theme_override_colors/font_color = Color(0.753, 0.392, 0.235, 1)
theme_override_font_sizes/font_size = 64

[node name="Bonus" type="Label" parent="Scroll/Box"]
layout_mode = 2
